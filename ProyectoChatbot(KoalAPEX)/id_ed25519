# Usa Oracle Linux 8 como imagen base
FROM oraclelinux:8

    ## Instala dependencias, Python 3.9, y crea el symlink necesario
    RUN dnf update -y && \
        dnf install -y oracle-epel-release-el8 && \
        dnf module enable -y python39 && \
        dnf install -y python39 java-11-openjdk-devel wget unzip tar which curl && \
        ln -sf /usr/bin/python3.9 /usr/bin/python && \
        dnf clean all

    ## Instala Google Cloud CLI
    RUN curl -O https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz && \
        tar -xzf google-cloud-cli-linux-x86_64.tar.gz && \
        ./google-cloud-sdk/install.sh -q && \
        rm google-cloud-cli-linux-x86_64.tar.gz

            #### Agrega Google Cloud SDK al PATH
            ENV PATH="/google-cloud-sdk/bin:${PATH}"

    ## Establece el directorio de trabajo
    WORKDIR /agileorganizer
    
        ## Copia el archivo JAR de la aplicación y otros archivos necesarios#
        COPY target/MyTodoList-0.0.1-SNAPSHOT.jar MyTodoList-0.0.1-SNAPSHOT.jar
        COPY Walet/Wallet_reacttodoa2fwz Wallet_reacttodoa2fwz
        COPY src/main/java/com/springboot/MyTodoList/jsons/request.json request.json
        COPY Walet/GoogleWallet/speech-to-text-key.json speech-to-text-key.json
        COPY src/main/java/com/springboot/MyTodoList/jsons/files.json files.json
        
        ## Expone los puertos
    EXPOSE 8080 9898
        
        ## Crea el directorio de audios
    RUN mkdir -p /agileorganizer/audios
        
        ### Copia los archivos de la aplicación
        COPY src/main/java/com/springboot/MyTodoList/data/Bot/voice/pepepecas.ogg audios/pepepecas.ogg
    
            #### Establece los permisos de los archivos
            RUN chmod 600 /agileorganizer/Wallet_reacttodoa2fwz
        
            #### Configura las variables de entorno
            ENV db_url="jdbc:oracle:thin:@reacttodoa2fwz_tp?TNS_ADMIN=Wallet_reacttodoa2fwz"
            ENV db_user="TODOUSER"
            ENV dbpassword="None74108520"

            #### Preparación segura de credenciales
            ENV GOOGLE_APPLICATION_CREDENTIALS=/agileorganizer/speech-to-text-key.json
            ENV TELEGRAM_BOT_TOKEN="7634429333:AAFSh1O6KNWPYnsB1JY12XljkTeLZ3918uU"
            ENV TELEGRAM_BOT_NAME="KoalAPEX_first_bot"

    ## Activate service account and set project
    RUN gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS && \
        gcloud config set project superb-vigil-454818-n0

    ## Copia las credencials por defecto
    RUN mkdir -p /root/.config/gcloud && \
        cp /agileorganizer/speech-to-text-key.json /root/.config/gcloud/application_default_credentials.json

    ## Install transfer agents
    #RUN gcloud transfer agents install --pool=koalapex-stt-transfer --id-prefix=docker1 --mount-directories=/audios --project=superb-vigil-454818-n0
    ## Install ollama
            ENV ollama.api.url="http://ollama:11434/api/generate"
            ENV ollama.default.model="deepseek-r1:1.5b"
            ENV ollama.temperature=0.7
            ENV ollama.max-tokens=50000
            ENV intent.analysis.enabled=true
            ENV intent.auto-execute.enabled=true
            
# Establece el punto de entrada para ejecutar los comandos de gcloud y luego iniciar la aplicación Java
CMD ["/bin/bash"]
ENTRYPOINT ["java","-jar","MyTodoList-0.0.1-SNAPSHOT.jar"]
