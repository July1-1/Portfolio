            },
            "source": [
                "### **Registro en Sprint**"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {
                "azdata_cell_guid": "30598279-414a-46dd-98d0-df6e101ed307",
                "language": "sql",
                "tags": [
                    "hide_input"
                ]
            },
            "outputs": [],
            "source": [
                "-- Insertar 5 Sprints para cada Proyecto\n",
                "BEGIN\n",
                "    FOR rec IN (SELECT idProyecto, FechaCreacion FROM TODOUSER.Proyecto) LOOP\n",
                "        FOR i IN 1..5 LOOP\n",
                "            INSERT INTO TODOUSER.Sprint (idProyecto, FechaInicio, FechaFin, Nombre, Activo)\n",
                "            VALUES (\n",
                "                rec.idProyecto,\n",
                "                rec.FechaCreacion + (7 * (i - 1)),  -- Inicio del sprint\n",
                "                rec.FechaCreacion + (7 * i),        -- Fin del sprint (una semana después)\n",
                "                'Sprint ' || i,\n",
                "                1\n",
                "            );\n",
                "        END LOOP;\n",
                "    END LOOP;\n",
                "END;\n",
                "/"
            ]
        },
