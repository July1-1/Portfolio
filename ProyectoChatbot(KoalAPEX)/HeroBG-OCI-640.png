                ]
            },
            "outputs": [],
            "source": [
                "-- Insertar Equipos\n",
                "INSERT INTO TODOUSER.Equipo (idEquipo, Nombre, Notificacion, Activo) \n",
                "VALUES (TODOUSER.Equipo_seq.NEXTVAL, 'Koalas', TO_TIMESTAMP('12:00:00', 'HH24:MI:SS'), 1);\n",
                "\n",
                "INSERT INTO TODOUSER.Equipo (idEquipo, Nombre, Notificacion, Activo) \n",
                "VALUES (TODOUSER.Equipo_seq.NEXTVAL, 'KoalAndroid', TO_TIMESTAMP('12:00:00', 'HH24:MI:SS'), 1);\n",
                "\n",
                "INSERT INTO TODOUSER.Equipo (idEquipo, Nombre, Notificacion, Activo) \n",
