            "outputs": [],
            "source": [
                "-- Crear la tabla Equipo_Proyecto\n",
                "CREATE TABLE TODOUSER.Equipo_Proyecto (\n",
                "    idEquipo_Proyecto NUMBER PRIMARY KEY,\n",
                "    idEquipo NUMBER NULL,\n",
                "    idProyecto NUMBER NULL,\n",
                "    Activo NUMBER(1) DEFAULT 1 CHECK (Activo IN (0,1)),\n",
                "    CONSTRAINT fk_EquipoProyecto_Equipo FOREIGN KEY (idEquipo)          REFERENCES TODOUSER.Equipo(idEquipo),\n",
                "    CONSTRAINT fk_EquipoProyecto_Proyecto FOREIGN KEY (idProyecto)      REFERENCES TODOUSER.Proyecto(idProyecto)\n",
                ");\n",
                "\n",
                "CREATE SEQUENCE TODOUSER.Equipo_Proyecto_seq START WITH 1 INCREMENT BY 1;\n",
                "\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Equipo_Proyecto_trg\n",
                "BEFORE INSERT ON TODOUSER.Equipo_Proyecto\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idEquipo_Proyecto IS NULL THEN\n",
                "        SELECT Equipo_Proyecto_seq.NEXTVAL INTO :NEW.idEquipo_Proyecto FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "/"
            ]
        },
