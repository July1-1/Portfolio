                "language": "sql"
            },
            "source": [
                "### **Tabla Proyecto**"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {
                "azdata_cell_guid": "591f638b-0b33-4ec3-8831-d8d5a6e2811e",
                "language": "sql",
                "tags": [
                    "hide_input"
                ]
            },
            "outputs": [],
            "source": [
                "-- Crear la tabla Proyecto\n",
                "CREATE TABLE TODOUSER.Proyecto (\n",
                "    idProyecto NUMBER PRIMARY KEY,\n",
                "    Nombre VARCHAR2(100) NOT NULL,\n",
                "    FechaCreacion DATE NULL,\n",
                "    Descripcion CLOB NULL,\n",
                "    Activo NUMBER(1) DEFAULT 1 CHECK (Activo IN (0,1))\n",
                ");\n",
                "\n",
                "CREATE SEQUENCE TODOUSER.Proyecto_seq START WITH 1 INCREMENT BY 1;\n",
                "CREATE OR REPLACE TRIGGER Proyecto_trg\n",
                "BEFORE INSERT ON TODOUSER.Proyecto\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idProyecto IS NULL THEN\n",
                "        SELECT TODOUSER.Proyecto_seq.NEXTVAL INTO :NEW.idProyecto FROM DUAL;\n",
                "    END IF;\n",
                "END;"
            ]
        },
        {
            "attachments": {},
            "cell_type": "markdown",
            "metadata": {
                "azdata_cell_guid": "1ddd92d4-0965-43df-8f27-83e46553c518",
                "language": "sql"
            },
            "source": [
                "### **Tabla Sprint**"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {
                "azdata_cell_guid": "bc7cb2d1-afae-4661-ac20-461165898861",
                "language": "sql",
                "tags": [
                    "hide_input"
                ]
            },
            "outputs": [],
            "source": [
                "-- Crear la tabla Sprint\n",
                "CREATE TABLE TODOUSER.Sprint (\n",
                "    idSprint NUMBER PRIMARY KEY,\n",
                "    idProyecto NUMBER NULL,\n",
                "    FechaInicio TIMESTAMP NOT NULL,\n",
                "    FechaFin TIMESTAMP NULL,\n",
                "    Nombre VARCHAR2(100) DEFAULT 'SprintProyecto',\n",
                "    Activo NUMBER(1) DEFAULT 1 CHECK (Activo IN (0,1)),\n",
                "    CONSTRAINT fk_Sprint_Proyecto FOREIGN KEY (idProyecto) REFERENCES TODOUSER.Proyecto(idProyecto)\n",
                ");\n",
                "\n",
                "CREATE SEQUENCE TODOUSER.Sprint_seq START WITH 1 INCREMENT BY 1;\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Sprint_trg\n",
                "BEFORE INSERT ON TODOUSER.Sprint\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idSprint IS NULL THEN\n",
                "        SELECT Sprint_seq.NEXTVAL INTO :NEW.idSprint FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "/"
            ]
        },
        {
            "attachments": {},
            "cell_type": "markdown",
            "metadata": {
