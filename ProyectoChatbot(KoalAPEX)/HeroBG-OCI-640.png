            "source": [
                "## **Triggers y condicionales adicionales para la integridad de los datos**"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "A continuacion se muestran los *Disparadores* que se han utilizado para mantener la integridad de los datos en nuestro proyecto."
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### **Talbla de historial de cambios en talba de tareas**"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "CREATE TABLE TODOUSER.HISTORIAL_ESTADO_TAREA (\n",
                "    ID_HISTORIAL NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n",
                "    IDTAREA NUMBER,\n",
                "    IDUSUARIO NUMBER,\n",
                "    ESTADO_ANTERIOR VARCHAR2(100),\n",
                "    ESTADO_NUEVO VARCHAR2(100),\n",
                "    FECHA_CAMBIO TIMESTAMP DEFAULT SYSTIMESTAMP,\n",
                "    ACTIVO NUMBER(1) DEFAULT 1 CHECK (ACTIVO IN (0,1))\n",
                ");\n",
                "\n",
                "-- Secuencia de Auto Incremento \n",
                "CREATE SEQUENCE TODOUSER.Historial_seq START WITH 1 INCREMENT BY 1;\n",
                "\n",
                "-- Trigger para auto incremento de idHistorial\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Historial_trg\n",
                "BEFORE INSERT ON TODOUSER.HISTORIAL_ESTADO_TAREA\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.id_Historial IS NULL THEN\n",
                "        SELECT Historial_seq.NEXTVAL INTO :NEW.id_Historial FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "\n",
                "\n",
                "-- Trigger para registrar cambios en el estado de las tareas\n",
                "CREATE OR REPLACE EDITIONABLE TRIGGER trg_historial_estado\n",
                "AFTER UPDATE ON TODOUSER.TAREA\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "  IF (:OLD.ESTADO IS NULL OR :NEW.ESTADO IS NULL) THEN\n",
                "    IF (:OLD.ESTADO IS NOT NULL OR :NEW.ESTADO IS NOT NULL) THEN\n",
                "      -- One is NULL and the other is not – there is a change.\n",
                "      INSERT INTO TODOUSER.HISTORIAL_ESTADO_TAREA (\n",
                "        IDTAREA,\n",
                "        IDUSUARIO,\n",
                "        ESTADO_ANTERIOR,\n",
                "        ESTADO_NUEVO,\n",
                "        FECHA_CAMBIO,\n",
                "        ACTIVO\n",
                "      )\n",
                "      VALUES (\n",
                "        :NEW.IDTAREA,\n",
                "        SYS_CONTEXT('KOALAPEX_CTX', 'IDUSUARIO'),\n",
                "        :OLD.ESTADO,\n",
                "        :NEW.ESTADO,\n",
                "        SYSTIMESTAMP,\n",
                "        1\n",
                "      );\n",
                "    END IF;\n",
                "  ELSIF :OLD.ESTADO <> :NEW.ESTADO THEN\n",
                "    -- Both are not NULL and are different.\n",
                "    INSERT INTO TODOUSER.HISTORIAL_ESTADO_TAREA (\n",
                "      IDTAREA,\n",
                "      IDUSUARIO,\n",
                "      ESTADO_ANTERIOR,\n",
                "      ESTADO_NUEVO,\n",
                "      FECHA_CAMBIO,\n",
                "      ACTIVO\n",
                "    )\n",
                "    VALUES (\n",
                "      :NEW.IDTAREA,\n",
                "      SYS_CONTEXT('KOALAPEX_CTX', 'IDUSUARIO'),\n",
                "      :OLD.ESTADO,\n",
                "      :NEW.ESTADO,\n",
                "      SYSTIMESTAMP,\n",
                "      1\n",
                "    );\n",
                "  END IF;\n",
                "END;\n",
                "/\n",
                "ALTER TRIGGER trg_historial_estado ENABLE;\n",
                "\n",
                "\n",
                "-- Trigger para insertar en Historial_Estado_Tarea al insertar una nueva tarea\n",
                "CREATE OR REPLACE TRIGGER trg_historial_tarea_insert\n",
                "AFTER INSERT ON TODOUSER.TAREA\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "  INSERT INTO TODOUSER.HISTORIAL_ESTADO_TAREA (\n",
                "    IDTAREA,\n",
                "    IDUSUARIO,\n",
                "    ESTADO_ANTERIOR,\n",
                "    ESTADO_NUEVO,\n",
                "    FECHA_CAMBIO,\n",
                "    ACTIVO\n",
                "  )\n",
                "  VALUES (\n",
                "    :NEW.IDTAREA,\n",
                "    SYS_CONTEXT('KOALAPEX_CTX', 'IDUSUARIO'),  -- Get user ID from context\n",
                "    NULL,            -- On insert, estado_anterior is null\n",
                "    :NEW.ESTADO,\n",
                "    SYSTIMESTAMP,\n",
                "    1\n",
                "  );\n",
                "END;\n",
                "/\n",
                "ALTER TRIGGER trg_historial_tarea_insert ENABLE;\n",
                "\n",
                "\n",
                "-- Trigger para insertar en Historial_Estado_Tarea al borrar una tarea\n",
                "CREATE OR REPLACE TRIGGER trg_historial_tarea_delete\n",
                "AFTER DELETE ON TODOUSER.TAREA\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "  INSERT INTO TODOUSER.HISTORIAL_ESTADO_TAREA (\n",
                "    IDTAREA,\n",
                "    IDUSUARIO,\n",
                "    ESTADO_ANTERIOR,\n",
                "    ESTADO_NUEVO,\n",
                "    FECHA_CAMBIO,\n",
                "    ACTIVO\n",
                "  )\n",
                "  VALUES (\n",
                "    :OLD.IDTAREA,\n",
                "    SYS_CONTEXT('KOALAPEX_CTX', 'IDUSUARIO'),\n",
                "    :OLD.ESTADO,    -- For delete, use the old state in estado_anterior\n",
                "    NULL,          -- estado_nuevo is null when the record is deleted\n",
                "    SYSTIMESTAMP,\n",
                "    1\n",
                "  );\n",
                "END;\n",
                "/\n",
                "ALTER TRIGGER trg_historial_tarea_delete ENABLE;\n",
                "\n",
                "\n"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "CREATE TABLE USUARIO_HISTORIAL(\n",
                "    IDUSUARIO_HISTORIAL NUMBER PRIMARY KEY,\n",
                "    IDUSUARIO NUMBER,\n",
                "    ID_HISTORIAL NUMBER,\n",
                "    LEIDA NUMBER(1) DEFAULT 0 CHECK (LEIDA IN (0,1)),\n",
                "    ACTIVO NUMBER(1) DEFAULT 1 CHECK (ACTIVO IN (0,1))\n",
                ")\n",
                "\n",
                "-- Secuencia de Auto Incremento\n",
                "CREATE SEQUENCE TODOUSER.Usuario_Historial_seq START WITH 1 INCREMENT BY 1;\n",
                "\n",
                "-- Trigger para auto incremento de idUsuario_Historial\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Usuario_Historial_trg\n",
                "BEFORE INSERT ON TODOUSER.USUARIO_HISTORIAL\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idUsuario_Historial IS NULL THEN\n",
                "        SELECT Usuario_Historial_seq.NEXTVAL INTO :NEW.idUsuario_Historial FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "\n",
                "\n",
                "-- Trigger para insertar en Usuario_Historial tras insertar en Historial_Estado_Tarea\n",
                "CREATE OR REPLACE TRIGGER compound_trg_historial_after_insert\n",
                "FOR INSERT ON HISTORIAL_ESTADO_TAREA\n",
                "COMPOUND TRIGGER\n",
                "\n",
                "  -- Colección para guardar ID_HISTORIAL de múltiples filas\n",
                "  TYPE t_history_ids IS TABLE OF HISTORIAL_ESTADO_TAREA.ID_HISTORIAL%TYPE;\n",
                "  v_history_ids t_history_ids := t_history_ids();\n",
                "\n",
                "  BEFORE EACH ROW IS\n",
                "  BEGIN\n",
                "    v_history_ids.EXTEND;\n",
                "    v_history_ids(v_history_ids.LAST) := :NEW.ID_HISTORIAL;\n",
                "  END BEFORE EACH ROW;\n",
                "\n",
                "  AFTER STATEMENT IS\n",
                "  BEGIN\n",
                "    -- Por cada ID_HISTORIAL nuevo, añade un registro USUARIO_HISTORIAL para cada usuario.\n",
                "    FOR i IN 1 .. v_history_ids.COUNT LOOP\n",
                "      INSERT INTO USUARIO_HISTORIAL (IDUSUARIO, ID_HISTORIAL)\n",
                "      SELECT IDUSUARIO, v_history_ids(i)\n",
                "      FROM USUARIOS;\n",
                "    END LOOP;\n",
                "  END AFTER STATEMENT;\n",
                "\n",
                "END compound_trg_historial_after_insert;\n",
                "/\n"
            ]
        }
    ],
