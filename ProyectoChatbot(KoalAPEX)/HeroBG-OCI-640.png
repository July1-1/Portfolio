            "outputs": [],
            "source": [
                "-- Crear la tabla Usuario_Equipo\n",
                "CREATE TABLE TODOUSER.Usuario_Equipo (\n",
                "    idUsuario_equipo NUMBER PRIMARY KEY,\n",
                "    idUsuario NUMBER NULL,\n",
                "    idEquipo NUMBER NULL,\n",
                "    Rol VARCHAR2(100) DEFAULT 'Desarrollador',\n",
                "    Activo NUMBER(1) DEFAULT 1 CHECK (Activo IN (0,1)),\n",
                "    CONSTRAINT fk_UsuarioEquipo_Usuario FOREIGN KEY (idUsuario) REFERENCES TODOUSER.Usuarios(idUsuario),\n",
                "    CONSTRAINT fk_UsuarioEquipo_Equipo FOREIGN KEY (idEquipo) REFERENCES TODOUSER.Equipo(idEquipo)\n",
                ");\n",
                "\n",
                "CREATE SEQUENCE TODOUSER.Usuario_Equipo_seq START WITH 1 INCREMENT BY 1;\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Usuario_Equipo_trg\n",
                "BEFORE INSERT ON TODOUSER.Usuario_Equipo\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idUsuario_equipo IS NULL THEN\n",
                "        SELECT TODOUSER.Usuario_Equipo_seq.NEXTVAL INTO :NEW.idUsuario_equipo FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "/\n"
            ]
        },
