            },
            "source": [
                "### **Tabla Desarrollador**"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {
                "azdata_cell_guid": "c4f191ed-a686-4c16-b17f-03b09668c37d",
                "language": "sql",
                "tags": [
                    "hide_input"
                ]
            },
            "outputs": [],
            "source": [
                "-- Crear la tabla Desarrollador\n",
                "CREATE TABLE TODOUSER.Desarrollador (\n",
                "    idDesarrollador NUMBER PRIMARY KEY,\n",
                "    idUsuario NUMBER NULL,\n",
                "    Modalidad VARCHAR2(100) DEFAULT 'Presencial',\n",
                "    CodigoChamba VARCHAR2(100) DEFAULT '0888880',\n",
                "    Activo NUMBER(1) DEFAULT 1 CHECK (Activo IN (0,1)),\n",
                "    CONSTRAINT fk_Desarrollador_Usuario FOREIGN KEY (idUsuario) REFERENCES TODOUSER.Usuarios(idUsuario)\n",
                ");\n",
                "\n",
                "CREATE SEQUENCE TODOUSER.Desarrollador_seq START WITH 1 INCREMENT BY 1;\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Desarrollador_trg\n",
                "BEFORE INSERT ON TODOUSER.Desarrollador\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idDesarrollador IS NULL THEN\n",
                "        SELECT Desarrollador_seq.NEXTVAL INTO :NEW.idDesarrollador FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "/"
            ]
        },
        {
            "attachments": {},
            "cell_type": "markdown",
            "metadata": {
                "azdata_cell_guid": "c3b2a487-3a3c-415d-88c5-44c92c02118d",
                "language": "sql"
            },
            "source": [
                "### **Tabla Tarea**"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {
                "azdata_cell_guid": "433ce3d1-34b7-4c34-a579-38edc8022e6b",
                "language": "sql",
                "tags": [
                    "hide_input"
                ]
            },
            "outputs": [],
            "source": [
                "-- Crear la tabla Tarea\n",
                "CREATE TABLE TODOUSER.Tarea (\n",
                "    idTarea NUMBER PRIMARY KEY,\n",
                "    Descripcion VARCHAR2(100) NULL,\n",
                "    FechaEntrega TIMESTAMP NULL,\n",
                "    Horas_Estimadas NUMBER DEFAULT 2,\n",
                "    Horas_Reales VARCHAR2(100) DEFAULT '2',\n",
                "    Activo NUMBER(1) DEFAULT 1 CHECK (Activo IN (0,1)),\n",
                "    Estado VARCHAR2(100) DEFAULT 'Activo',\n",
                "    Categoria VARCHAR2(100) DEFAULT 'Tarea',\n",
                "    idDesarrollador NUMBER NULL,\n",
                "    idProyecto NUMBER NULL,\n",
                "    idSprint NUMBER NULL,\n",
                "    CONSTRAINT fk_Tarea_Desarrollador FOREIGN KEY (idDesarrollador) REFERENCES TODOUSER.Desarrollador(idDesarrollador),\n",
                "    CONSTRAINT fk_Tarea_Proyecto FOREIGN KEY (idProyecto)           REFERENCES TODOUSER.Proyecto(idProyecto),\n",
                "    CONSTRAINT fk_Tarea_Sprint FOREIGN KEY (idSprint)               REFERENCES TODOUSER.Sprint(idSprint)\n",
                ");\n",
                "\n",
                "CREATE SEQUENCE TODOUSER.Tarea_seq START WITH 1 INCREMENT BY 1;\n",
                "\n",
                "CREATE OR REPLACE TRIGGER TODOUSER.Tarea_trg\n",
                "BEFORE INSERT ON TODOUSER.Tarea\n",
                "FOR EACH ROW\n",
                "BEGIN\n",
                "    IF :NEW.idTarea IS NULL THEN\n",
                "        SELECT Tarea_seq.NEXTVAL INTO :NEW.idTarea FROM DUAL;\n",
                "    END IF;\n",
                "END;\n",
                "/\n"
            ]
        },
        {
            "attachments": {},
            "cell_type": "markdown",
            "metadata": {
