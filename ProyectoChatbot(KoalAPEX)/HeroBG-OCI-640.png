                "-- Insertar en Desarrollador\n",
                "INSERT INTO TODOUSER.Desarrollador (idUsuario, Modalidad, CodigoChamba, Activo) \n",
                "SELECT idUsuario, 'Presencial', '0888880', 1 FROM TODOUSER.Usuarios WHERE Nombre = 'Victor Escalante'\n",
                "UNION ALL\n",
                "SELECT idUsuario, 'Remoto', '0444440', 1 FROM TODOUSER.Usuarios WHERE Nombre = 'Hugo Peres'\n",
                "UNION ALL\n",
                "SELECT idUsuario, 'Híbrido', '0484480', 1 FROM TODOUSER.Usuarios WHERE Nombre = 'Diego Reyna'\n",
