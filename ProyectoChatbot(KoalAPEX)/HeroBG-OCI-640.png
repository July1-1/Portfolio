                "        (SELECT idDesarrollador FROM TODOUSER.DESARROLLADOR WHERE idUsuario = (SELECT idUsuario FROM TODOUSER.Usuarios WHERE Nombre = 'Julio Madrigal')),\n",
                "        (SELECT idProyecto FROM TODOUSER.Proyecto WHERE Nombre = 'KoalaBOT'),\n",
                "        (SELECT idSprint FROM TODOUSER.Sprint WHERE idSprint = 5 +13));\n",
                "\n",
                "-- Tarea 13: M4 | Actividad en clase: Modelando al usuario (Sprint 3)\n",
                "INSERT INTO TODOUSER.Tarea (idTarea, Descripcion, FechaEntrega, Horas_Estimadas, Horas_Reales, Activo, Estado, Categoria, idDesarrollador, idProyecto, idSprint)\n",
                "VALUES (TODOUSER.Tarea_seq.NEXTVAL, 'M4 | Actividad en clase: Modelando al usuario', TO_DATE('2024-02-24', 'YYYY-MM-DD'), 2, 3, 1, 'Completado', 'Actividad-clase',\n",
                "        (SELECT idDesarrollador FROM TODOUSER.DESARROLLADOR WHERE idUsuario = (SELECT idUsuario FROM TODOUSER.Usuarios WHERE Nombre = 'Julio Madrigal')),\n",
                "        (SELECT idProyecto FROM TODOUSER.Proyecto WHERE Nombre = 'KoalaBOT'),\n",
                "        (SELECT idSprint FROM TODOUSER.Sprint WHERE idSprint = 5 +13));\n",
                "\n",
                "-- Tarea 15: Actividad: Mapas mentales de preparación sobre estándares de Ingeniería de Software (Sprint 3)\n",
                "INSERT INTO TODOUSER.Tarea (idTarea, Descripcion, FechaEntrega, Horas_Estimadas, Horas_Reales, Activo, Estado, Categoria, idDesarrollador, idProyecto, idSprint)\n",
                "VALUES (TODOUSER.Tarea_seq.NEXTVAL, 'Actividad: Mapas mentales de preparación sobre estándares de Ingeniería de Software', TO_DATE('2024-02-28', 'YYYY-MM-DD'), 2, 3, 1, 'Completado', 'Actividad-clase',\n",
                "        (SELECT idDesarrollador FROM TODOUSER.DESARROLLADOR WHERE idUsuario = (SELECT idUsuario FROM TODOUSER.Usuarios WHERE Nombre = 'Julio Madrigal')),\n",
                "        (SELECT idProyecto FROM TODOUSER.Proyecto WHERE Nombre = 'KoalaBOT'),\n",
                "        (SELECT idSprint FROM TODOUSER.Sprint WHERE idSprint = 5 +13));"
            ]
